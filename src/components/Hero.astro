---
import { Image } from "astro:assets";
import retrato from "../assets/prints/hero-geremias.jpg";
import { whatsappLink } from "../data/contact";

const whatsapp = whatsappLink("Olá Geremias, gostaria de pedir um orçamento ✨");

const indice = ["Balayage", "Correção de cor", "Morena iluminada"];
---

<section id="top" class="relative overflow-hidden bg-[#1a1a1a]">
  <div class="relative grid lg:min-h-[92svh] lg:grid-cols-[1.1fr_1fr] lg:items-stretch">
    <!-- Foto — contida (rosto+ombros) no mobile para não ficar atrás do texto;
         full-bleed só a partir de lg, onde já é uma coluna própria ao lado do texto.
         Imagem LCP: eager + fetchpriority="high", nunca lazy -->
    <div data-reveal class="pincelada relative aspect-[4/5] w-full overflow-hidden lg:aspect-auto lg:h-full">
      <Image
        src={retrato}
        alt="Retrato de estúdio de Geremias Kiim, cabeleireiro e colorista em Lisboa"
        class="h-full w-full object-cover object-top"
        widths={[480, 768, 1024, 1448, 1932, 2400]}
        sizes="(min-width: 1024px) 55vw, 100vw"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#1a1a1a] to-transparent lg:inset-0 lg:h-auto lg:bg-gradient-to-r lg:from-[#1a1a1a]/10 lg:via-transparent lg:to-transparent"></div>
    </div>

    <div class="relative z-10 flex flex-col gap-6 bg-[#1a1a1a] px-5 py-10 sm:px-8 sm:py-12 lg:justify-center lg:px-14 lg:py-16">
      <!-- Sem kicker acima do H1 — ver craft-floor.md do Impeccable ("eyebrow
           above a heading" é ban, não default). "Lisboa" já está no parágrafo
           abaixo ("Santos, Lisboa"), sem perda de informação. -->
      <h1 class="text-balance font-display text-[clamp(2.75rem,11vw,4.25rem)] leading-[0.95] text-white sm:text-6xl lg:text-7xl xl:text-8xl">
        Especialista em
        <span data-reveal style="--reveal-delay: 350ms" class="pincelada relative block text-[color:var(--color-primaria)]">loiros naturais</span>
      </h1>

      <p class="max-w-md text-base text-white/70 sm:text-lg">
        Realce sua beleza com técnica e cuidado — atendimento boutique no Solo Concept Beauty Coworking, Santos, Lisboa.
      </p>

      <ul class="flex flex-wrap gap-x-5 gap-y-1 border-t border-white/15 pt-4 text-xs tracking-[0.15em] text-white/50 uppercase">
        {indice.map((item, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" class="text-white/25">—</span>}
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-2 flex flex-wrap gap-4">
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="hover-lift inline-flex min-h-11 items-center rounded-full bg-[color:var(--color-destaque)] px-7 py-3.5 text-sm font-medium text-white shadow-sm"
        >
          Peça seu orçamento no WhatsApp
        </a>
        <a
          href="#galeria"
          class="hover-lift inline-flex min-h-11 items-center rounded-full border border-white/25 px-7 py-3.5 text-sm font-medium text-white"
        >
          Ver o trabalho
        </a>
      </div>
    </div>
  </div>
</section>
