---
import { Image } from "astro:assets";
import balayageCaramelo from "../assets/prints/galeria-balayage-caramelo.jpg";
import loiroGlam from "../assets/prints/galeria-loiro-glam.jpg";
import ruivoAcobreado from "../assets/prints/galeria-ruivo-acobreado.jpg";
import morenaCurta from "../assets/prints/galeria-morena-curta.jpg";
import morenaPraiana from "../assets/prints/galeria-morena-praiana.jpg";
import cachosBalayage from "../assets/prints/galeria-cachos-balayage.jpg";
import loiroDourado from "../assets/prints/galeria-loiro-dourado.jpg";
import moneyPiece from "../assets/prints/galeria-money-piece.jpg";

// Legendas descritivas (técnica/tom visível na foto) — não são nomes de produto
// nem legendas originais confirmadas post a post, ver site-brief.json > Galeria.
// Curadoria Impeccable 2026-09-09: reduzido de 10 para 8 fotos, removendo 2
// variações de balayage redundantes com outras já presentes (critique P2 —
// carga cognitiva: conteúdo exposto de uma vez sem hierarquia).
const fotos = [
  { img: balayageCaramelo, legenda: "Balayage caramelo com franja" },
  { img: loiroGlam, legenda: "Loiro glam" },
  { img: ruivoAcobreado, legenda: "Ruivo acobreado" },
  { img: morenaCurta, legenda: "Morena curta" },
  { img: moneyPiece, legenda: "Money piece — franja iluminada" },
  { img: morenaPraiana, legenda: "Morena iluminada" },
  { img: cachosBalayage, legenda: "Cachos com balayage" },
  { img: loiroDourado, legenda: "Loiro dourado" },
];
---

<section id="galeria" class="mx-auto max-w-6xl px-5 py-20 md:py-28">
  <div data-reveal class="mx-auto max-w-2xl text-center">
    <div class="divider-gold mb-5"><span></span></div>
    <h2 class="text-balance font-display text-3xl text-[color:var(--color-texto)] sm:text-4xl md:text-5xl">Galeria de trabalhos</h2>
    <p class="mt-4 text-[color:var(--color-texto)]/70">
      Uma amostra real de clientes atendidas no salão — resultados de coloração e técnica, sem edição de estúdio.
    </p>
  </div>

  <div class="mt-12 columns-2 gap-4 sm:columns-3 md:columns-4">
    {fotos.map((foto, i) => (
      <div
        data-reveal
        style={`--reveal-delay: ${(i % 4) * 70}ms`}
        class="hover-lift group relative mb-4 break-inside-avoid overflow-hidden rounded-xl shadow-[0_8px_24px_-16px_rgba(26,26,26,0.4)]"
      >
        <Image
          src={foto.img}
          alt={`Cabelo com ${foto.legenda.toLowerCase()}, resultado real de cliente atendida por Geremias Kiim`}
          class="w-full object-cover transition duration-500 group-hover:scale-105"
          widths={[240, 360, 480]}
          sizes="(min-width: 1024px) 15rem, (min-width: 640px) 33vw, 50vw"
        />
        <div
          class="galeria-legenda pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/65 via-black/5 to-transparent p-3 opacity-0 transition duration-300 group-hover:opacity-100"
        >
          <p class="text-xs font-medium tracking-wide text-white">{foto.legenda}</p>
        </div>
      </div>
    ))}
  </div>
</section>
